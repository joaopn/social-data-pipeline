# The chat's sandbox (sdp chat setup builds it as sdp-sandbox).
# The Chat window's assistant works in it: Python with the analysis packages of requirements-sandbox.txt, and Claude Code at a pinned version, runnable by any uid (it is to run as the operator's uid with a read-only root).
FROM python:3.13-slim
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
# The root is read-only at run time: Claude Code is not to try to update itself.
ENV DISABLE_AUTOUPDATER=1
# A failure anywhere in a pipe fails the step.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

COPY requirements-sandbox.txt /tmp/requirements-sandbox.txt
RUN pip install --no-cache-dir -r /tmp/requirements-sandbox.txt && rm /tmp/requirements-sandbox.txt

# Claude Code at a pinned version, without the vendor's installer (which runs the newest release to install the one asked for): the pinned binary is downloaded directly, checked against the SHA-256 written here before it is made executable or run, and installed at /usr/local/bin/claude (mode 0755), runnable by any uid. Nothing unpinned runs in the build.
# CLAUDE_CODE_BASE is the installer's own download location (install.sh fetches <base>/<version>/<platform>/claude from it), measured when the version was pinned. The sums are of the Claude Code binary of 2.1.328 for linux-x64 (amd64) and linux-arm64, measured from the downloaded binaries when the version was pinned (they equal the vendor's manifest.json for it); another version needs its own sums, and an architecture without a sum fails the build.
ARG CLAUDE_CODE_VERSION=2.1.328
ARG CLAUDE_CODE_BASE=https://downloads.claude.ai/claude-code-releases
RUN case "$(dpkg --print-architecture)" in \
        amd64) platform=linux-x64; sum=a982d38030b97e750848add2cbb2df6d9a70d5544a22ca9b216a349ba25865e8 ;; \
        arm64) platform=linux-arm64; sum=307f8bada27b37db7553fac75e86004e3dbff5a931ffc611b54fe710ce1eb521 ;; \
        *) echo "Dockerfile.sandbox: no SHA-256 of Claude Code is recorded for the architecture $(dpkg --print-architecture) (only amd64 and arm64): the build stops rather than install it unchecked" >&2; exit 1 ;; \
    esac \
    && apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && mkdir -m 0700 /tmp/claude-download \
    && { curl -fsSL -o /tmp/claude-download/claude "$CLAUDE_CODE_BASE/$CLAUDE_CODE_VERSION/$platform/claude" \
         || { echo "Dockerfile.sandbox: Claude Code $CLAUDE_CODE_VERSION for $platform could not be downloaded from $CLAUDE_CODE_BASE (has the address moved?)" >&2; exit 1; }; } \
    && { echo "$sum  /tmp/claude-download/claude" | sha256sum -c - \
         || { echo "Dockerfile.sandbox: the downloaded Claude Code $CLAUDE_CODE_VERSION for $platform is not the binary measured when it was pinned (its SHA-256 differs): the build stops" >&2; exit 1; }; } \
    && install -m 0755 /tmp/claude-download/claude /usr/local/bin/claude \
    && rm -rf /tmp/claude-download \
    && test "$(HOME=/tmp/claude-version claude --version)" = "$CLAUDE_CODE_VERSION (Claude Code)" \
    && rm -rf /tmp/claude-version \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/*

# The chat's runner (standard library only), the agent of its OpenAI-compatible back end (which uses the mcp package of requirements-sandbox.txt), and the two modules of the control package the runner uses for the frames of its socket.
WORKDIR /app
COPY social_data_pipeline/__init__.py /app/social_data_pipeline/__init__.py
COPY social_data_pipeline/control/__init__.py social_data_pipeline/control/errors.py social_data_pipeline/control/framing.py /app/social_data_pipeline/control/
COPY social_data_pipeline/chat/ /app/social_data_pipeline/chat/
RUN chmod -R a+rX /app
# sdp_data, with which the assistant's scripts query the attached databases through the gateway (chat/sdp_data.py, which imports nothing of the package), as a top-level module in the interpreter's own site-packages: `python3 -I` ignores PYTHONPATH and imports it there too.
RUN install -m 0644 /app/social_data_pipeline/chat/sdp_data.py "$(python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')/sdp_data.py" \
    && python -I -c "import sdp_data, mcp"

# Nobody by default; the chat is to run it as the operator's uid and gid.
USER 65534:65534

CMD ["python", "-m", "social_data_pipeline.chat"]
